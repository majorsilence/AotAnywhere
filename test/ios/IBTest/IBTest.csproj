<Project Sdk="Microsoft.NET.Sdk">
  <!-- iOS validation app for StuDev.AotAnywhere.Apple (see .github/workflows/ios-validation.yml):
       three storyboards (navigation, controls and segues; tab bar) whose controllers drive their
       own outlets, actions and segues on launch and log "IBTEST <storyboard> ok", plus an app icon
       asset catalog. Launch it with the storyboard option set to Showcase, Controls or Tabbed
       (test/ios/run-sim.py). Builds against the package sources through Directory.Build.targets. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.companyname.ibtest</ApplicationId>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
