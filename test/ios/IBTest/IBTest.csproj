<Project Sdk="Microsoft.NET.Sdk">
  <!-- iOS validation app for StuDev.AotAnywhere.Apple (see .github/workflows/ios-validation.yml):
       storyboards (navigation, controls and segues; tab bar; tables, collections, gestures,
       unwind segues and a storyboard reference; pickers, map and web views, every gesture
       recognizer, table header/footer views, collection section views and a custom layout)
       whose controllers drive their own outlets,
       actions and segues on launch and log "IBTEST <storyboard> ok", plus an asset catalog
       (app icon, colours, vector and dark-mode images, data) checked the same way. Launch it with
       the storyboard option set to Showcase, Controls, Tabbed, Gaps, More or Assets
       (test/ios/run-sim.py). Builds against the package sources through Directory.Build.targets. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.companyname.ibtest</ApplicationId>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
