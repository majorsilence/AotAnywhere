             .pagezero_size = options.pagezero_size,
             .headerpad_size = options.headerpad_size,
             .headerpad_max_install_names = options.headerpad_max_install_names,
@@ -3482,6 +3487,8 @@ fn addNonIncrementalStuffToCacheManifest(comp: *Compilation, man: *Cache.Manifes
 
     // Mach-O specific stuff
     try man.addInputPathOptional(opts.entitlements, .{});
+    man.hash.add(opts.macho_exported_symbols != null);
+    if (opts.macho_exported_symbols) |list| man.hash.addListOfBytes(list);
     man.hash.addOptional(opts.pagezero_size);
     man.hash.addOptional(opts.headerpad_size);
     man.hash.add(opts.headerpad_max_install_names);
