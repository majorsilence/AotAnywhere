diff --git a/src/link/MachO.zig b/src/link/MachO.zig
index eb3e6d0543..4a9b49383b 100644
--- a/src/link/MachO.zig
+++ b/src/link/MachO.zig
@@ -124,6 +124,10 @@ lib_directories: []const Directory,
 install_name: ?[]const u8,
 /// Path to entitlements file.
 entitlements: ?Path,
+/// Symbols (or ld64 wildcard patterns) to export, from -exported_symbols_list
+/// and -exported_symbol. Globals not matched are made private extern, as with
