+    /// (Darwin) Symbols (or ld64 wildcard patterns) to export, from
+    /// -exported_symbols_list / -exported_symbol. Globals not matched are
+    /// made private extern. null exports every global.
+    macho_exported_symbols: ?[]const []const u8 = null,
     /// (Darwin) size of the __PAGEZERO segment
     pagezero_size: ?u64 = null,
     /// (Darwin) set minimum space for future expansion of the load commands
@@ -2249,6 +2253,7 @@ pub fn create(gpa: Allocator, arena: Allocator, io: Io, diag: *CreateDiagnostic,
             .enable_link_snapshots = options.enable_link_snapshots,
             .install_name = options.install_name,
             .entitlements = options.entitlements,
