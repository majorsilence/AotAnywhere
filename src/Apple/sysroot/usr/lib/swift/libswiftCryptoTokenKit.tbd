--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/usr/lib/swift/libswiftCryptoTokenKit.dylib'
current-version: 878.0.13
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ '$ld$install_name$os10.0$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os10.1$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os10.2$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os10.3$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os11.0$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os11.1$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os11.2$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os11.3$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os11.4$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os12.0$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os12.1$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os7.0$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os7.1$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os8.0$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os8.1$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os8.2$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os8.3$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os8.4$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os9.0$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os9.1$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os9.2$@rpath/libswiftCryptoTokenKit.dylib',
                        '$ld$install_name$os9.3$@rpath/libswiftCryptoTokenKit.dylib' ]
reexports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _TKErrorDomain ]
    objc-classes:     [ TKBERTLVRecord, TKCompactTLVRecord, TKSimpleTLVRecord, TKSmartCard,
                        TKSmartCardATR, TKSmartCardATRInterfaceGroup, TKSmartCardPINFormat,
                        TKSmartCardSlot, TKSmartCardSlotManager, TKSmartCardSlotNFCSession,
                        TKSmartCardToken, TKSmartCardTokenDriver,
                        TKSmartCardTokenRegistrationManager, TKSmartCardTokenSession,
                        TKSmartCardUserInteraction, TKSmartCardUserInteractionForPINOperation,
                        TKSmartCardUserInteractionForSecurePINChange,
                        TKSmartCardUserInteractionForSecurePINVerification, TKTLVRecord, TKToken,
                        TKTokenAuthOperation, TKTokenConfiguration, TKTokenDriver,
                        TKTokenDriverConfiguration, TKTokenKeyAlgorithm,
                        TKTokenKeyExchangeParameters, TKTokenKeychainCertificate,
                        TKTokenKeychainContents, TKTokenKeychainItem, TKTokenKeychainKey,
                        TKTokenPasswordAuthOperation, TKTokenSession,
                        TKTokenSmartCardPINAuthOperation, TKTokenWatcher, TKTokenWatcherTokenInfo ]
...
