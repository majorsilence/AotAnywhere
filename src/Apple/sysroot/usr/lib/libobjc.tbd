--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/usr/lib/libobjc.A.dylib'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ ___objc_personality_v0, __objc_empty_cache, _class_addIvar,
                        _class_addMethod, _class_addProperty, _class_addProtocol,
                        _class_copyIvarList, _class_copyMethodList, _class_copyPropertyList,
                        _class_copyProtocolList, _class_getClassMethod, _class_getInstanceMethod,
                        _class_getInstanceVariable, _class_getMethodImplementation, _class_getName,
                        _class_getSuperclass, _class_isMetaClass, _ivar_getName,
                        _method_getDescription, _method_getName, _method_getTypeEncoding,
                        _objc_alloc, _objc_allocWithZone, _objc_alloc_init, _objc_allocateClassPair,
                        _objc_allocateProtocol, _objc_autorelease, _objc_autoreleasePoolPop,
                        _objc_autoreleasePoolPush, _objc_autoreleaseReturnValue, _objc_begin_catch,
                        _objc_end_catch, _objc_enumerationMutation, _objc_exception_throw,
                        _objc_getAssociatedObject, _objc_getClass, _objc_getClassList,
                        _objc_getProtocol, _objc_msgSend, _objc_msgSendSuper, _objc_msgSendSuper2,
                        _objc_msgSendSuper_stret, _objc_msgSend_stret, _objc_opt_class,
                        _objc_opt_self, _objc_registerClassPair, _objc_registerProtocol,
                        _objc_release, _objc_retain, _objc_retainAutorelease,
                        _objc_retainAutoreleasedReturnValue, _objc_setAssociatedObject,
                        _object_getClass, _object_getClassName, _property_getName,
                        _protocol_addMethodDescription, _protocol_addProperty,
                        _protocol_addProtocol, _protocol_getMethodDescription, _protocol_getName,
                        _sel_getName, _sel_isMapped, _sel_registerName ]
    objc-classes:     [ NSObject ]
...
