--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/SoundAnalysis.framework/SoundAnalysis'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _SNClassifierIdentifierVersion1, _SNErrorDomain ]
    objc-classes:     [ SNAudioFileAnalyzer, SNAudioStreamAnalyzer, SNClassification,
                        SNClassificationResult, SNClassifySoundRequest, SNTimeDurationConstraint ]
...
