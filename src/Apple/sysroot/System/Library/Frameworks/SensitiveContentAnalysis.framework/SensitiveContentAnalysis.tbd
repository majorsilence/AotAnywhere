--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/SensitiveContentAnalysis.framework/SensitiveContentAnalysis'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _SCSensitiveContentTypeGoreOrViolence,
                        _SCSensitiveContentTypeSexuallyExplicit ]
    objc-classes:     [ SCSensitivityAnalysis, SCSensitivityAnalyzer, SCVideoStreamAnalyzer ]
...
