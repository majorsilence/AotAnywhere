--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/AVSystemRouting.framework/AVSystemRouting'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _AVSystemRoutingErrorDomain ]
    objc-classes:     [ AVSystemRoute, AVSystemRouteController, AVSystemRouteDataChannel,
                        AVSystemRouteEvent, AVSystemRouteMediaSession, AVSystemRouteSession ]
...
