    objc-classes:     [ QLFilePreviewRequest, QLPreviewController, QLPreviewProvider,
                        QLPreviewReply, QLPreviewReplyAttachment,
                        QLPreviewSceneActivationConfiguration, QLPreviewSceneOptions ]
...
