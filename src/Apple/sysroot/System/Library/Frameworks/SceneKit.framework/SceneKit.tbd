                        _SCNSceneSourceAnimationImportPolicyPlayRepeatedly,
                        _SCNSceneSourceAnimationImportPolicyPlayUsingSceneTimeBase,
                        _SCNSceneSourceAssetAuthorKey, _SCNSceneSourceAssetAuthoringToolKey,
