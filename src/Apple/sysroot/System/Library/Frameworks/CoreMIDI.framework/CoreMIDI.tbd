                        _kMIDIPropertySupportsGeneralMIDI, _kMIDIPropertySupportsMMC,
                        _kMIDIPropertySupportsShowControl, _kMIDIPropertyTransmitChannels,
                        _kMIDIPropertyTransmitsBankSelectLSB, _kMIDIPropertyTransmitsBankSelectMSB,
                        _kMIDIPropertyTransmitsClock, _kMIDIPropertyTransmitsMTC,
                        _kMIDIPropertyTransmitsNotes, _kMIDIPropertyTransmitsProgramChanges,
                        _kMIDIPropertyUMPActiveGroupBitmap, _kMIDIPropertyUMPCanTransmitGroupless,
