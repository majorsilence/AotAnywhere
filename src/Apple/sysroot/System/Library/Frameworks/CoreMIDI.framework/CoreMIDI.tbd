    objc-classes:     [ MIDI2DeviceInfo, MIDICIDevice, MIDICIDeviceInfo, MIDICIDeviceManager,
                        MIDICIDiscoveredNode, MIDICIDiscoveryManager, MIDICIProfile,
                        MIDICIProfileState, MIDICIResponder, MIDICISession, MIDINetworkConnection,
