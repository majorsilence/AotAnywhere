--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/CoreLocation.framework/CoreLocation'
current-version: 3185.0.6
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _CLLocationPushServiceErrorDomain, _kCLErrorDomain,
                        _kCLErrorUserInfoAlternateRegionKey ]
    objc-classes:     [ CLBackgroundActivitySession, CLBackgroundActivitySessionDiagnostic,
                        CLBeacon, CLBeaconIdentityCondition, CLBeaconIdentityConstraint,
                        CLBeaconRegion, CLCircularGeographicCondition, CLCircularRegion,
                        CLCondition, CLGeocoder, CLHeading, CLLocationManager, CLLocationUpdater,
                        CLMonitor, CLMonitorConfiguration, CLMonitoringEvent, CLMonitoringRecord,
                        CLPlacemark, CLRegion, CLServiceSession, CLServiceSessionDiagnostic,
                        CLUpdate, CLVisit ]
reexports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [
                        '$ld$previous$/System/Library/Frameworks/CoreLocation.framework/CoreLocation$$2$2.0$19.0$$',
                        '$ld$previous$/System/Library/Frameworks/CoreLocation.framework/CoreLocation$$7$2.0$19.0$$',
                        _CLLocationCoordinate2DIsValid, _CLLocationDistanceMax, _CLTimeIntervalMax,
                        _kCLDistanceFilterNone, _kCLLocationAccuracyBest,
                        _kCLLocationAccuracyBestForNavigation, _kCLLocationAccuracyHundredMeters,
                        _kCLLocationAccuracyKilometer, _kCLLocationAccuracyNearestTenMeters,
                        _kCLLocationAccuracyReduced, _kCLLocationAccuracyThreeKilometers ]
    objc-classes:     [ CLFloor, CLLocation, CLLocationSourceInformation ]
...
