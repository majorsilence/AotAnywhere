--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/QuickLookThumbnailing.framework/QuickLookThumbnailing'
current-version: 0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _QLThumbnailErrorDomain ]
    objc-classes:     [ QLFileThumbnailRequest, QLThumbnailGenerationRequest, QLThumbnailGenerator,
                        QLThumbnailProvider, QLThumbnailReply, QLThumbnailRepresentation ]
...
