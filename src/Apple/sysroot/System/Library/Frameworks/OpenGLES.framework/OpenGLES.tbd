--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/OpenGLES.framework/OpenGLES'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _EAGLGetVersion, _kEAGLColorFormatRGB565, _kEAGLColorFormatRGBA8,
                        _kEAGLDrawablePropertyColorFormat, _kEAGLDrawablePropertyRetainedBacking ]
    objc-classes:     [ EAGLContext, EAGLSharegroup ]
...
