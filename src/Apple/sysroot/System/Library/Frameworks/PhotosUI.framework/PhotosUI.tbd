--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/PhotosUI.framework/PhotosUI'
current-version: 912.0.234
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    objc-classes:     [ PHEditingExtensionContext, PHLivePhotoView, PHPickerConfiguration,
                        PHPickerFilter, PHPickerResult, PHPickerSearchText,
                        PHPickerUpdateConfiguration, PHPickerViewController,
                        PHSharedAlbumCreationConfiguration, PHSharedAlbumCreationResult,
                        PHSharedAlbumCreationViewController,
                        PHSharedAlbumCustomizationViewController,
                        PHSharedAlbumPostingViewController ]
...
