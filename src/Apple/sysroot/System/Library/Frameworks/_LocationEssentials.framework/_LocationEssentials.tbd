--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/_LocationEssentials.framework/_LocationEssentials'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [
                        '$ld$previous$/System/Library/Frameworks/CoreLocation.framework/CoreLocation$$2$2.0$19.0$$',
                        '$ld$previous$/System/Library/Frameworks/CoreLocation.framework/CoreLocation$$7$2.0$19.0$$',
                        _CLLocationCoordinate2DIsValid, _CLLocationDistanceMax, _CLTimeIntervalMax,
                        _kCLDistanceFilterNone, _kCLLocationAccuracyBest,
                        _kCLLocationAccuracyBestForNavigation, _kCLLocationAccuracyHundredMeters,
                        _kCLLocationAccuracyKilometer, _kCLLocationAccuracyNearestTenMeters,
                        _kCLLocationAccuracyReduced, _kCLLocationAccuracyThreeKilometers ]
    objc-classes:     [ CLFloor, CLLocation, CLLocationSourceInformation ]
...
