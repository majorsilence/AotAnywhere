--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/BackgroundAssets.framework/BackgroundAssets'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _BAAssetPackIdentifierErrorKey, _BADownloaderPriorityDefault,
                        _BADownloaderPriorityMax, _BADownloaderPriorityMin, _BAErrorDomain,
                        _BAFailuresErrorKey, _BAManagedErrorDomain, _BASuccessesErrorKey ]
    objc-classes:     [ BAAppExtensionInfo, BAAssetPack, BAAssetPackManager, BAAssetPackManifest,
                        BADownload, BADownloadManager, BAURLDownload ]
...
