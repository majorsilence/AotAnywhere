--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/FileProvider.framework/FileProvider'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _NSFileProviderDomainDidChange, _NSFileProviderErrorCollidingItemKey,
                        _NSFileProviderErrorDomain, _NSFileProviderErrorItemKey,
                        _NSFileProviderErrorNonExistentItemIdentifierKey,
                        _NSFileProviderFavoriteRankUnranked, _NSFileProviderInitialPageSortedByDate,
                        _NSFileProviderInitialPageSortedByName,
                        _NSFileProviderMaterializedSetDidChange, _NSFileProviderPendingSetDidChange,
                        _NSFileProviderRootContainerItemIdentifier,
                        _NSFileProviderTrashContainerItemIdentifier,
                        _NSFileProviderUserInfoExperimentIDKey,
                        _NSFileProviderWorkingSetContainerItemIdentifier ]
    objc-classes:     [ NSFileProviderDomain, NSFileProviderDomainVersion, NSFileProviderExtension,
                        NSFileProviderItemVersion, NSFileProviderManager, NSFileProviderRequest ]
...
