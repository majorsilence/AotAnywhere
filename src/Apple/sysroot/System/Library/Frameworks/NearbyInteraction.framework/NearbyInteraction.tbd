--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/NearbyInteraction.framework/NearbyInteraction'
current-version: 0
compatibility-version: 0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _NIAlgorithmConvergenceStatusReasonDescription,
                        _NIAlgorithmConvergenceStatusReasonInsufficientHorizontalSweep,
                        _NIAlgorithmConvergenceStatusReasonInsufficientLighting,
                        _NIAlgorithmConvergenceStatusReasonInsufficientMovement,
                        _NIAlgorithmConvergenceStatusReasonInsufficientVerticalSweep,
                        _NIErrorDomain, _NINearbyObjectAngleNotAvailable,
                        _NINearbyObjectDirectionNotAvailable, _NINearbyObjectDistanceNotAvailable,
                        _NINearbyObjectWorldTransformNotAvailable ]
    objc-classes:     [ NIAlgorithmConvergence, NIConfiguration, NIDLTDOAConfiguration,
                        NIDLTDOAMeasurement, NIDLTDOAMeasurementFloorElevation, NIDiscoveryToken,
                        NINearbyAccessoryConfiguration, NINearbyObject, NINearbyPeerConfiguration,
                        NISession ]
...
