--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/DeviceDiscoveryExtension.framework/DeviceDiscoveryExtension'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _DDDeviceProtocolStringDIAL, _DDDeviceProtocolStringInvalid,
                        _DDErrorDomain ]
    objc-classes:     [ DDDevice, DDDeviceEvent, DDDiscoverySession ]
...
