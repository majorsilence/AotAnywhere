--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/JavaScriptCore.framework/JavaScriptCore'
current-version: 625.1.29
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _JSPropertyDescriptorConfigurableKey, _JSPropertyDescriptorEnumerableKey,
                        _JSPropertyDescriptorGetKey, _JSPropertyDescriptorSetKey,
                        _JSPropertyDescriptorValueKey, _JSPropertyDescriptorWritableKey ]
    objc-classes:     [ JSContext, JSManagedValue, JSValue, JSVirtualMachine ]
...
