--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/MetricKit.framework/MetricKit'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _MXErrorDomain ]
    objc-classes:     [ MXAnimationMetric, MXAppExitMetric, MXAppLaunchDiagnostic,
                        MXAppLaunchMetric, MXAppResponsivenessMetric, MXAppRunTimeMetric, MXAverage,
                        MXBackgroundExitData, MXCPUExceptionDiagnostic, MXCPUMetric,
                        MXCallStackTree, MXCellularConditionMetric, MXCrashDiagnostic,
                        MXCrashDiagnosticObjectiveCExceptionReason, MXDiagnostic,
                        MXDiagnosticPayload, MXDiskIOMetric, MXDiskSpaceUsageMetric,
                        MXDiskWriteExceptionDiagnostic, MXDisplayMetric, MXForegroundExitData,
                        MXGPUMetric, MXHangDiagnostic, MXHistogram, MXHistogramBucket,
                        MXLocationActivityMetric, MXMemoryMetric, MXMetaData, MXMetric,
                        MXMetricManager, MXMetricPayload, MXNetworkTransferMetric,
                        MXSignpostIntervalData, MXSignpostMetric, MXSignpostRecord,
                        MXUnitAveragePixelLuminance, MXUnitSignalBars ]
...
