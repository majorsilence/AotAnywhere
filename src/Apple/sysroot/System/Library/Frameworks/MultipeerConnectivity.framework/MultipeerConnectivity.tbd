--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/MultipeerConnectivity.framework/MultipeerConnectivity'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _MCErrorDomain, _kMCSessionMaximumNumberOfPeers,
                        _kMCSessionMinimumNumberOfPeers ]
    objc-classes:     [ MCAdvertiserAssistant, MCBrowserViewController, MCNearbyServiceAdvertiser,
                        MCNearbyServiceBrowser, MCPeerID, MCSession ]
...
