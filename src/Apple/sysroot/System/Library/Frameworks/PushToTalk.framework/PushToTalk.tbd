--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/PushToTalk.framework/PushToTalk'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _PTChannelErrorDomain, _PTInstantiationErrorDomain ]
    objc-classes:     [ PTChannelDescriptor, PTChannelManager, PTParticipant, PTPushResult ]
...
