--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/PencilKit.framework/PencilKit'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _PKAppleDrawingTypeIdentifier, _PKInkTypeCrayon, _PKInkTypeFountainPen,
                        _PKInkTypeMarker, _PKInkTypeMonoline, _PKInkTypePen, _PKInkTypePencil,
                        _PKInkTypeReed, _PKInkTypeWatercolor ]
    objc-classes:     [ PKCanvasView, PKConvertedBezierPoint, PKDrawing, PKEraserTool, PKFloatRange,
                        PKInk, PKInkingTool, PKLassoTool, PKResponderState, PKStroke, PKStrokePath,
                        PKStrokePoint, PKStrokeRenderState, PKTool, PKToolPicker,
                        PKToolPickerCustomItem, PKToolPickerCustomItemConfiguration,
                        PKToolPickerEraserItem, PKToolPickerInkingItem, PKToolPickerItem,
                        PKToolPickerLassoItem, PKToolPickerRulerItem, PKToolPickerScribbleItem ]
...
