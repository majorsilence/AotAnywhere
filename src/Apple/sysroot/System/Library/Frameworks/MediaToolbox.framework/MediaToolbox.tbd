--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/MediaToolbox.framework/MediaToolbox'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _MTAudioProcessingTapCreate, _MTAudioProcessingTapCreateWithPreferredFormat,
                        _MTAudioProcessingTapGetSourceAudio, _MTAudioProcessingTapGetStorage,
                        _MTCopyLocalizedNameForMediaSubType, _MTCopyLocalizedNameForMediaType ]
...
