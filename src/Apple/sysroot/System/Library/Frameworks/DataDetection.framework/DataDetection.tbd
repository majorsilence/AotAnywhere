--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/DataDetection.framework/DataDetection'
current-version: 847.1.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    objc-classes:     [ DDMatch, DDMatchCalendarEvent, DDMatchEmailAddress, DDMatchFlightNumber,
                        DDMatchLink, DDMatchMoneyAmount, DDMatchPhoneNumber, DDMatchPostalAddress,
                        DDMatchShipmentTrackingNumber ]
...
