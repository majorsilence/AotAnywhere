--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/OSLog.framework/OSLog'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    objc-classes:     [ OSLogEntry, OSLogEntryActivity, OSLogEntryBoundary, OSLogEntryLog,
                        OSLogEntrySignpost, OSLogEnumerator, OSLogMessageComponent, OSLogPosition,
                        OSLogStore ]
...
