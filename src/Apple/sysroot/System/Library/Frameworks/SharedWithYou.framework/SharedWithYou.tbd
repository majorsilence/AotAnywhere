--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/SharedWithYou.framework/SharedWithYou'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _SWCollaborationMetadataTypeIdentifier ]
    objc-classes:     [ SWAttributionView, SWCollaborationHighlight, SWCollaborationView,
                        SWHighlight, SWHighlightCenter, SWHighlightChangeEvent,
                        SWHighlightMembershipEvent, SWHighlightMentionEvent,
                        SWHighlightPersistenceEvent, SWRemoveParticipantAlertController ]
reexports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _SWCopyRepresentationTypeIdentifier, _UTCollaborationOptionsTypeIdentifier ]
    objc-classes:     [ SWAction, SWCollaborationCoordinator, SWCollaborationMetadata,
                        SWCollaborationOption, SWCollaborationOptionsGroup,
                        SWCollaborationOptionsPickerGroup, SWCollaborationShareOptions, SWPerson,
                        SWPersonIdentity, SWPersonIdentityProof, SWSignedPersonIdentityProof,
                        SWStartCollaborationAction, SWUpdateCollaborationParticipantsAction ]
...
