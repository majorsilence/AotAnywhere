--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/IdentityLookup.framework/IdentityLookup'
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _ILMessageFilterErrorDomain ]
    objc-classes:     [ ILCallClassificationRequest, ILCallCommunication, ILClassificationRequest,
                        ILClassificationResponse, ILCommunication, ILMessageClassificationRequest,
                        ILMessageCommunication, ILMessageFilterCapabilitiesQueryRequest,
                        ILMessageFilterCapabilitiesQueryResponse, ILMessageFilterExtension,
                        ILMessageFilterExtensionContext, ILMessageFilterQueryRequest,
                        ILMessageFilterQueryResponse, ILNetworkResponse ]
...
