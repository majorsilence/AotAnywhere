--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/TouchController.framework/TouchController'
compatibility-version: 0.0.0
exports:
  - targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
    symbols:          [ _TCGameControllerProductCategoryTouchController ]
    objc-classes:     [ TCButton, TCButtonDescriptor, TCControlContents, TCControlImage,
                        TCControlLabel, TCDirectionPad, TCDirectionPadDescriptor, TCSwitch,
                        TCSwitchDescriptor, TCThrottle, TCThrottleDescriptor, TCThumbstick,
                        TCThumbstickDescriptor, TCTouchController, TCTouchControllerDescriptor,
                        TCTouchpad, TCTouchpadDescriptor ]
...
