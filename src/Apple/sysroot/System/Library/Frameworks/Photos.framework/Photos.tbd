--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios, arm64-ios-simulator, x86_64-ios-simulator ]
install-name:    '/System/Library/Frameworks/Photos.framework/Photos'
current-version: 912.0.234
